{
  "info": {
    "name": "Foro - Moderacion",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Flujo sobre un tema y comentario existentes y visibles. Bloquea y restaura ambos recursos. Requiere Usuarios, Foro y Moderacion ejecutandose y migracion 002 aplicada."
  },
  "variable": [
    {
      "key": "moderacionUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "foroUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "temaId",
      "value": ""
    },
    {
      "key": "comentarioId",
      "value": ""
    },
    {
      "key": "adminCorreo",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "usuarioCorreo",
      "value": ""
    },
    {
      "key": "usuarioPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Estado de Moderacion",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{moderacionUrl}}/api/estado",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Sin credenciales: bloqueo rechazado",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{moderacionUrl}}/api/moderacion/temas/{{temaId}}",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bloqueado\": true,\n  \"motivo\": \"Prueba de permisos\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "USUARIO: bloqueo rechazado",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{moderacionUrl}}/api/moderacion/temas/{{temaId}}",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{usuarioCorreo}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{usuarioPassword}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bloqueado\": true,\n  \"motivo\": \"Prueba de permisos\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "ADMIN: bloquear tema",
